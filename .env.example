# Copy to .env and fill in ONE provider to enable the MaskGuard AI assistant.

# Option A - Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=gsk_...
LLM_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-120b            # or openai/gpt-oss-20b, qwen/qwen3.8-27b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo # voice questions

# Option B - Anthropic Claude: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=claude
# CLAUDE_MODEL=claude-opus-5-5
